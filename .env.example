# --- Required ---
DISCORD_TOKEN=your_bot_token_here

# --- Ownership ---
# Primary owner (used as the DM-relay target and an owner).
OWNER_ID=your_discord_user_id_here
# Extra owners, comma-separated.
OWNER_IDS=id1,id2

# --- Moderation ---
# Users who must never be pinged; mentioning them deletes the message.
# Defaults to RUNE JERRY's account if unset.
PROTECTED_USER_IDS=214331989774434305
# Channel where YouTube links are allowed.
ALLOWED_YT_CHANNEL=0

# --- YouTube notifications ---
YT_CHANNEL_1=0
YT_CHANNEL_2=0
YT_CHANNEL_3=0
# Set to 0 to announce new videos without pinging @everyone.
YT_PING=1

# --- General ---
COMMAND_PREFIX=#
