# --- Required ---
DISCORD_TOKEN=your_bot_token_here

# --- Ownership ---
# Primary owner (used as the DM-relay target and an owner).
OWNER_ID=your_discord_user_id_here
# Extra owners, comma-separated.
OWNER_IDS=id1,id2

# --- Moderation ---
# Users who must never be pinged; mentioning them deletes the message.
# Defaults to RUNE JERRY's account if unset.
PROTECTED_USER_IDS=214331989774434305
# Channel where YouTube links are allowed.
ALLOWED_YT_CHANNEL=0
# Channel automated moderation actions are reported to. 0 disables logging.
MOD_LOG_CHANNEL_ID=0

# --- Scam filter ---
# Timeout (minutes) applied when a scam link is caught.
SCAM_TIMEOUT_MINUTES=60
# Links from accounts younger than this many days are removed. 0 disables.
NEW_ACCOUNT_LINK_DAYS=3

# --- Raid protection ---
# This many joins inside the window triggers a lockdown.
RAID_JOIN_THRESHOLD=10
RAID_WINDOW_SECONDS=60
# How long the raised verification level stays in place.
RAID_LOCKDOWN_MINUTES=15

# --- Notification ping roles ---
# Members self-assign these instead of the bot pinging @everyone.
VIDEO_PING_ROLE_ID=1547335266233098381
LIVE_PING_ROLE_ID=1547335343685238795

# --- YouTube notifications ---
YT_CHANNEL_1=0
YT_CHANNEL_2=0
YT_CHANNEL_3=0
# Set to 0 to announce new uploads without any ping.
YT_PING=1

# --- General ---
COMMAND_PREFIX=.
